{
  "name": "port-ago",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "knip": "PAYLOAD_SECRET=knip DATABASE_URI=file:./knip.db knip --reporter compact",
    "duplicates": "jscpd --config .jscpd.json .",
    "quality": "npm run lint && npm run knip && npm run type-check && npm run duplicates",
    "quality:ci": "npm run quality && npm run build",
    "check-all": "npm run quality:ci",
    "seed": "set -a && . ./.env && set +a && npx tsx seed.ts",
    "generate:types": "payload generate:types",
    "prepare": "husky"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "^3.83.0",
    "@payloadcms/next": "^3.83.0",
    "@payloadcms/payload-cloud": "^3.83.0",
    "@payloadcms/richtext-lexical": "^3.83.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@vercel/analytics": "^2.0.1",
    "graphql": "^16.11.0",
    "next": "~16.2.6",
    "payload": "^3.83.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^8",
    "eslint-config-next": "^15.4.11",
    "eslint-plugin-sonarjs": "^4.0.3",
    "husky": "^9.1.7",
    "jscpd": "^4.2.3",
    "knip": "^6.14.1",
    "lint-staged": "^16.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "next lint --fix --max-warnings 0 --file"
  }
}
